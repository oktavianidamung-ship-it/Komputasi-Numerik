   "source": [
    "# TUGAS KOMPUTASI NUMERIK\n",
    "## Program Penyelesaian SPLTV - Metode Eliminasi Gauss\n",
    "**Nama:** Dominika Oktafiani Damung  \n",
    "**NIM:** 202511420010  \n",
    "**Program Studi:** Teknik Informatika - Universitas Dr. Soetomo Surabaya  \n",
    "\n",
    "**Penjelasan Cell:**  \n",
    "Cell ini memuat identitas mahasiswa dan judul tugas penyelesaian Sistem Persamaan Linear Tiga Variabel (SPLTV) dengan Metode Eliminasi Gauss."
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== TAHAP 1: INPUT DATA MATRIKS ===\n",
      "Bentuk Matriks Diperbesar [A|B]:\n",
      "[[ 3.  2.  4. 11.]\n",
      " [ 2.  1.  2.  6.]\n",
      " [ 1.  3.  5. 11.]]\n"
     ]
    }
   ],
   "source": [
    "# Penjelasan Cell: Mengaktifkan library NumPy, memasukkan koefisien (A) serta konstanta (B), lalu menggabungkannya menjadi Augmented Matrix [A|B].\n",
    "\n",
    "import numpy as np  # Mengimpor library NumPy untuk mengelola kalkulasi matriks dan array\n",
    "\n",
    "print(\"=== TAHAP 1: INPUT DATA MATRIKS ===\")  # Mencetak judul tahapan pertama ke layar\n",
    "\n",
    "# Mendefinisikan matriks koefisien persamaan A berukuran 3x3\n",
    "# Tipe data float digunakan agar pembagian bilangan desimal nantinya akurat\n",
    "A = np.array([[3.0, 2.0, 4.0],\n",
    "              [2.0, 1.0, 2.0],\n",
    "              [1.0, 3.0, 5.0]], dtype=float)\n",
    "\n",
    "# Mendefinisikan matriks konstanta hasil B di ruas kanan tanda sama dengan\n",
    "B = np.array([11.0, 6.0, 11.0], dtype=float)\n",
    "\n",
    "# Menggabungkan matriks A dan matriks B secara berdampingan menjadi satu matriks diperbesar [A|B]\n",
    "M = np.column_stack((A, B))\n",
    "\n",
    "# Mengambil jumlah total baris persamaan berdasarkan panjang ukuran matriks B (nilainya = 3)\n",
    "n = len(B)\n",
    "\n",
    "print(\"Bentuk Matriks Diperbesar [A|B]:\")  # Menampilkan teks keterangan matriks awal\n",
    "print(M)  # Menampilkan susunan matriks diperbesar [A|B] ke layar"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== TAHAP 2: PROSES ELIMINASI OBE ===\n",
      "Matriks Hasil Akhir Segitiga Atas:\n",
      "[[ 3.          2.          4.         11.        ]\n",
      " [ 0.         -0.33333333 -0.66666667 -1.33333333]\n",
      " [ 0.          0.         -1.         -2.        ]]\n"
     ]
    }
   ],
   "source": [
    "# Penjelasan Cell: Menjalankan Operasi Baris Elementer (OBE) untuk mengubah angka di bawah diagonal utama menjadi 0 (membentuk Matriks Segitiga Atas).\n",
    "\n",
    "print(\"=== TAHAP 2: PROSES ELIMINASI OBE ===\")  # Mencetak judul tahapan kedua ke layar\n",
    "\n",
    "# Perulangan pertama (i) untuk mengontrol baris diagonal utama yang dijadikan acuan (pivot)\n",
    "for i in range(n):\n",
    "    # Perulangan kedua (k) untuk menyisir semua baris yang terletak di bawah baris acuan (pivot)\n",
    "    for k in range(i + 1, n):\n",
    "        # Menghitung nilai faktor pengali: elemen di bawah diagonal dibagi elemen diagonal utamanya\n",
    "        faktor = M[k][i] / M[i][i]\n",
    "        \n",
    "        # Mengurangi seluruh elemen pada baris ke-k dengan hasil perkalian (faktor * baris acuan ke-i)\n",
    "        # Langkah ini secara matematis mengubah angka di bawah diagonal utama menjadi 0\n",
    "        M[k] = M[k] - faktor * M[i]\n",
    "\n",
    "print(\"Matriks Hasil Akhir Segitiga Atas:\")  # Menampilkan teks keterangan matriks hasil eliminasi\n",
    "print(M)  # Menampilkan matriks segitiga atas yang sudah bersih dari angka di bawah diagonal"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== TAHAP 3: SUBSTITUSI MUNDUR & OUTPUT ===\n",
      "Solusi Akhir Sistem:\n",
      "Nilai X = 1.00\n",
      "Nilai Y = -0.00\n",
      "Nilai Z = 2.00\n"
     ]
    }
   ],
   "source": [
    "# Penjelasan Cell: Melakukan kalkulasi hitung mundur (back substitution) dari baris bawah ke atas untuk menemukan nilai variabel X, Y, dan Z.\n",
    "\n",
    "print(\"=== TAHAP 3: SUBSTITUSI MUNDUR & OUTPUT ===\")  # Mencetak judul tahapan ketiga ke layar\n",
    "\n",
    "# Menyiapkan wadah array kosong berukuran n (3 elemen) untuk menampung solusi jawaban X, Y, dan Z\n",
    "X = np.zeros(n)\n",
    "\n",
    "# Menghitung nilai variabel paling akhir terlebih dahulu (Variabel Z pada indeks ke-2)\n",
    "# Rumus: Konstanta baris terakhir dibagi koefisien Z baris terakhir\n",
    "X[n-1] = M[n-1][n] / M[n-1][n-1]\n",
    "\n",
    "# Perulangan mundur dimulai dari baris kedua (indeks 1) hingga baris pertama (indeks 0)\n",
    "for i in range(n-2, -1, -1):\n",
    "    X[i] = M[i][n]  # Mengambil nilai konstanta pada baris ke-i terlebih dahulu\n",
    "    \n",
    "    # Mengurangi konstanta dengan perkalian koefisien variabel lain yang nilainya sudah ditemukan\n",
    "    for j in range(i+1, n):\n",
    "        X[i] = X[i] - M[i][j] * X[j]\n",
    "        \n",
    "    # Membagi hasil sisa pengurangan dengan nilai koefisien diagonal utama pada baris tersebut\n",
    "    X[i] = X[i] / M[i][i]\n",
    "\n",
    "# Menampilkan hasil cetak jawaban akhir ke layar dengan format pembulatan 2 angka desimal (.2f)\n",
    "print(\"Solusi Akhir Sistem:\")\n",
    "print(f\"Nilai X = {X[0]:.2f}\")  # Mencetak nilai variabel X (indeks ke-0)\n",
    "print(f\"Nilai Y = {X[1]:.2f}\")  # Mencetak nilai variabel Y (indeks ke-1)\n",
    "print(f\"Nilai Z = {X[2]:.2f}\")  # Mencetak nilai variabel Z (indeks ke-2)"
   ]
  }
